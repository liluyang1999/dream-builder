{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dream Builder Fantasy Tree",
  "version": "1.1.0",
  "identifier": "com.dreambuilder.fantasytree",
  "build": {
    "beforeDevCommand": "pnpm -C .. dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -C .. build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dream Builder Fantasy Tree",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#070914",
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Dream Builder",
    "copyright": "© 2026 Dream Builder",
    "category": "Game",
    "shortDescription": "在温暖的卡通森林中寻找光种，唤醒失色的智慧树",
    "longDescription": "《智慧树之森》是一款单人离线第三人称卡通森林冒险游戏。探索蘑菇坡、溪流与遗迹，收集三枚光种，聆听森林记忆并完成净化，让中央智慧树与周围生态重新发光。",
    "licenseFile": "installer/LICENSE.txt",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
