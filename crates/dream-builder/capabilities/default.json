{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window: core IPC plus the log, store, dialog, fs, and opener plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "log:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPLOG" }, { "path": "$APPLOG/**" }]
    }
  ]
}
